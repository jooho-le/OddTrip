# OddTrip 환경변수 템플릿. 이 파일을 .env로 복사한 뒤 값을 채우세요.
#   cp .env.example .env

# --- 필수 ---
DATABASE_URL=
AUTH_SECRET_KEY=

# --- 관리자 계정 ---
# 두 값이 모두 채워져 있으면 서버 기동 시 관리자 계정을 만듭니다.
# 비워두면 관리자 계정이 생기지 않아 /admin 화면에 들어갈 수 없습니다.
# 이미 있는 계정이면 비밀번호는 그대로 두고 권한만 올립니다.
# 같은 키를 두 번 쓰면 뒤에 있는 줄이 이깁니다. 값을 채울 때 아래 두 줄만 쓰세요.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 나머지 ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TOUR_API_SERVICE_KEY=
TOUR_API_RELATED_SERVICE_KEY=
TOUR_API_HUB_SERVICE_KEY=
TOUR_API_BIGDATA_SERVICE_KEY=
TOUR_API_CONCENTRATION_SERVICE_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_RELATED_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
TOUR_API_HUB_BASE_URL=https://apis.data.go.kr/B551011/LocgoHubTarService1
TOUR_API_BIGDATA_BASE_URL=https://apis.data.go.kr/B551011/DataLabService
TOUR_API_CONCENTRATION_BASE_URL=https://apis.data.go.kr/B551011/TarCongestionService
GOOGLE_MAPS_API_KEY=
KMA_API_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_DEMO_USER_HEADER_AUTH=false

# 여행 시작 하루 전 리마인더. 발송 시각은 한국 시간 기준이다.
# 외부 cron(python -m backend.app.cli reminders)으로 돌릴 때는 아래를 false로 둬도 된다.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SEND_HOUR_KST=9
REMINDER_CHECK_INTERVAL_MINUTES=15
